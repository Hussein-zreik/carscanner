<?xml version="1.0" encoding="utf-8"?>
<!-- CR-V Diag launcher glyph: gauge dial with needle, drawn inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- dial arc -->
    <path
        android:pathData="M30,64 A24,24 0 0,1 78,64"
        android:strokeWidth="6"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- tick marks -->
    <path
        android:pathData="M54,36 L54,42 M37,47 L41.2,51.2 M71,47 L66.8,51.2"
        android:strokeWidth="4"
        android:strokeColor="#7CC4FF"
        android:strokeLineCap="round" />
    <!-- needle -->
    <path
        android:pathData="M54,64 L67,47"
        android:strokeWidth="5"
        android:strokeColor="#7CC4FF"
        android:strokeLineCap="round" />
    <!-- hub -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,64 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
    <!-- OBD connector hint -->
    <path
        android:pathData="M40,74 L68,74"
        android:strokeWidth="4"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round" />
</vector>
